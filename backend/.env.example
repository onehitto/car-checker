# Copy to `.env` and adjust. Never commit a real `.env` file.

# --- Application -------------------------------------------------------------
# development | test | production
APP_ENV=development
API_PORT=8000
# Swagger UI / OpenAPI; defaults to true outside production
# ENABLE_DOCS=true

# --- Database (local or remote PostgreSQL) -----------------------------------
DATABASE_URL=postgresql+asyncpg://car_checker:car_checker@localhost:5432/car_checker
TEST_DATABASE_URL=postgresql+asyncpg://car_checker:car_checker@localhost:5432/car_checker_test
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# --- Authentication -----------------------------------------------------------
# Generate each secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value-for-access-tokens
JWT_REFRESH_SECRET=change-me-to-another-long-random-value-for-refresh
# Lifetimes in seconds: 15 minutes, 30 days, 30 minutes
ACCESS_TOKEN_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=2592000
PASSWORD_RESET_EXPIRES_IN=1800

# --- HTTP ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=30/minute
# Shared rate-limit counters across API replicas (memory backend when unset)
# REDIS_URL=redis://localhost:6379/0

# --- Files --------------------------------------------------------------------
STORAGE_BACKEND=local
UPLOAD_DIRECTORY=./var/uploads
# Bytes (10 MiB)
MAX_UPLOAD_SIZE=10485760

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console

# --- Email / notifications ----------------------------------------------------
# console | smtp
EMAIL_BACKEND=console
EMAIL_FROM=Car Checker <no-reply@carchecker.local>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
FRONTEND_URL=http://localhost:3000
