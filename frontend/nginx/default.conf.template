# Static single-page app + same-origin proxy to the API (no CORS needed).
# Environment variables are substituted at container start; nginx variables stay untouched.
# Trust only the subnet of the reverse proxy that terminates HTTPS.
geo $realip_remote_addr $trusted_proxy {
    default 0;
    ${TRUSTED_PROXY_CIDR} 1;
}

map "$trusted_proxy:$http_x_forwarded_proto" $forwarded_proto {
    default $scheme;
    "1:http" http;
    "1:https" https;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 12m;

    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    proxy_set_header Host $host;
    # Discard incoming address chains after resolving the last untrusted client.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Request-ID $request_id;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
    }

    location = /health {
        proxy_pass ${API_UPSTREAM}/health;
    }

    # Fingerprinted build output: cache for a year.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # Client-side routes all serve the app shell, never cached.
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
